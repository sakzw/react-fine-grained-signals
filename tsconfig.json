{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "react-alien-signals": ["./src/index.ts"],
      "react-alien-signals/jsx-runtime": ["./src/jsx-runtime.ts"],
      "react-alien-signals/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
