{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "react-fine-grained-signals": ["./src/index.ts"],
      "react-fine-grained-signals/internal": ["./src/internal.ts"],
      "react-fine-grained-signals/utils": ["./src/utils.tsx"],
      "react-fine-grained-signals/jsx": ["./src/jsx.ts"],
      "react-fine-grained-signals/jsx/jsx-runtime": ["./src/jsx/jsx-runtime.ts"],
      "react-fine-grained-signals/jsx/jsx-dev-runtime": ["./src/jsx/jsx-dev-runtime.ts"],
      "react-fine-grained-signals/jsx/lite": ["./src/jsx/lite.ts"],
      "react-fine-grained-signals/jsx/lite/jsx-runtime": ["./src/jsx/lite/jsx-runtime.ts"],
      "react-fine-grained-signals/jsx/lite/jsx-dev-runtime": ["./src/jsx/lite/jsx-dev-runtime.ts"]
    },
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "vitest.config.ts",
    "src/**/*.ts",
    "src/**/*.mts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "e2e/**/*.ts",
    "examples/browser/src/**/*.ts",
    "examples/browser/src/**/*.tsx"
  ],
  "exclude": [
    "tests/fixtures/**"
  ]
}
