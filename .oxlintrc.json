{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // React 19's automatic JSX runtime doesn't require `React` in scope.
    "react/react-in-jsx-scope": "off",
    // vitest's own mock/assertion strictness rules are noisy relative to the
    // payoff for this codebase; revisit if useful.
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off"
  },
  "overrides": [
    {
      // Tests routinely capture a hook/component's internal state into an
      // outer `let` during render purely so assertions can inspect it
      // afterwards; that's a test-only pattern, not a render side effect bug.
      // They also read `.value` as a bare statement to register a tracked
      // dependency (see the src/core override below) and mutate deep-signal
      // proxies returned from hooks directly to assert reactivity (see the
      // examples/benchmarks override below) -- both are the same intentional
      // API idioms exercised from test code instead of app code.
      "files": ["tests/**", "**/tests/**"],
      "rules": {
        "react/globals": "off",
        "no-unused-expressions": "off",
        "react/immutability": "off"
      }
    },
    {
      // These hooks forward caller-supplied dependency arrays through to
      // useMemo/useEffect, so the arrays are never literals and "exhaustive
      // deps" can't be statically verified here by design.
      "files": ["src/react/hooks.ts"],
      "rules": {
        "react/use-memo": "off",
        "react/memo-dependencies": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/exhaustive-deps": "off"
      }
    },
    {
      // The library's own signal/hook/JSX-runtime implementation. Reading
      // `.value` as a bare statement is how this code registers a reactive
      // dependency (the getter has the tracking side effect, so the read
      // isn't dead code), and `useSignals()`/deep-signal hooks intentionally
      // read `ref.current` during render to drive that same tracking.
      "files": ["src/core/**", "src/react/**", "src/runtime/**"],
      "rules": {
        "no-unused-expressions": "off",
        "react/refs": "off"
      }
    },
    {
      // A webpack/rspack loader is `this`-bound by contract: the compiler calls
      // it with the loader context as `this`, which is the only way to reach
      // `async()`, `query` and `resource`. The function is exported because a
      // loader module's default export *is* the loader.
      "files": ["packages/unplugin-react-fine-grained-signals/src/loader.ts"],
      "rules": {
        "oxc/no-this-in-exported-function": "off"
      }
    },
    {
      // Example apps and benchmarks are consumers of the public signal API,
      // so they necessarily exercise the same patterns the rules above
      // exempt in the library itself: mutating deep-signal proxies in place
      // via `.value` (which `react/immutability` can't distinguish from
      // mutating classic immutable props/state), reading `ref.current`
      // during render through `useSignals()`, and reading `.value` as a bare
      // statement to measure/exercise a tracked read.
      "files": ["examples/**", "benchmarks/**"],
      "rules": {
        "no-unused-expressions": "off",
        "react/immutability": "off",
        "react/refs": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
