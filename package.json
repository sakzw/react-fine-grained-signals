{
  "name": "react-fine-grained-signals",
  "version": "0.0.0",
  "description": "Fine-grained signal rendering for React 19, built on alien-signals.",
  "license": "MIT",
  "author": "akazawa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakzw/react-fine-grained-signals.git"
  },
  "homepage": "https://github.com/sakzw/react-fine-grained-signals#readme",
  "bugs": {
    "url": "https://github.com/sakzw/react-fine-grained-signals/issues"
  },
  "keywords": [
    "react",
    "signals",
    "signal",
    "fine-grained",
    "reactivity",
    "jsx",
    "jsx-runtime",
    "alien-signals"
  ],
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "pnpm build:runtime && node --expose-gc benchmarks/core.mjs",
    "bench:deep": "pnpm build:runtime && node --expose-gc benchmarks/deep-signal.mjs",
    "bench:react": "pnpm build:runtime && node --expose-gc benchmarks/react-render.mjs",
    "bench:transform": "pnpm build:transform && pnpm --filter unplugin-react-fine-grained-signals bench",
    "build": "pnpm build:runtime && pnpm build:transform",
    "build:runtime": "tsdown",
    "build:transform": "pnpm --filter unplugin-react-fine-grained-signals build",
    "dev:browser": "pnpm build:transform && node examples/browser/server.mjs",
    "build:browser": "pnpm build:transform && vite build --config examples/browser/vite.config.ts",
    "preview:browser": "vite preview --config examples/browser/vite.config.ts --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "pnpm typecheck:runtime && pnpm typecheck:transform",
    "typecheck:runtime": "tsc --noEmit",
    "typecheck:transform": "pnpm --filter unplugin-react-fine-grained-signals typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm test:runtime && pnpm test:transform",
    "test:runtime": "vitest run",
    "test:transform": "pnpm --filter unplugin-react-fine-grained-signals test",
    "test:coverage": "pnpm test:coverage:runtime && pnpm test:coverage:transform",
    "test:coverage:runtime": "vitest run --coverage",
    "test:coverage:transform": "pnpm --filter unplugin-react-fine-grained-signals test:coverage",
    "test:consumer": "pnpm build && node tests/consumer-smoke.mjs",
    "prepare:e2e": "pnpm --dir examples/react-router install --frozen-lockfile",
    "test:browser": "playwright test",
    "size": "pnpm build:runtime && node scripts/check-size.mjs",
    "size:update": "pnpm build:runtime && node scripts/check-size.mjs --update"
  },
  "peerDependencies": {
    "alien-signals": "^3.2.1",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@preact/signals-core": "1.14.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "alien-signals": "^3.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
