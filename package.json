{
  "name": "react-alien-signals",
  "version": "0.0.0",
  "description": "React bindings for alien-signals.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "pnpm build:runtime && node --expose-gc benchmarks/core.mjs",
    "bench:deep": "pnpm build:runtime && node --expose-gc benchmarks/deep-signal.mjs",
    "build": "pnpm build:runtime && pnpm build:transform",
    "build:runtime": "tsdown",
    "build:transform": "pnpm --filter unplugin-react-alien-signals build",
    "dev:browser": "node --import tsx examples/browser/server.mjs",
    "typecheck": "pnpm typecheck:runtime && pnpm typecheck:transform",
    "typecheck:runtime": "tsc --noEmit",
    "typecheck:transform": "pnpm --filter unplugin-react-alien-signals typecheck",
    "test": "pnpm test:runtime && pnpm test:transform",
    "test:runtime": "vitest run --passWithNoTests",
    "test:transform": "pnpm --filter unplugin-react-alien-signals test",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "dependencies": {
    "alien-signals": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@preact/signals-core": "1.14.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
