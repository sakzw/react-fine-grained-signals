{
  "name": "unplugin-react-alien-signals",
  "version": "0.0.0",
  "description": "Universal useSignals transform for react-alien-signals.",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node tests/build-smoke.mjs",
    "bench": "node --expose-gc benchmarks/transform.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:react-compiler": "vitest run tests/react-compiler.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react-alien-signals": "workspace:*"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/helper-plugin-utils": "^7.29.7",
    "@babel/types": "^7.29.8",
    "unplugin": "^2.3.10"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__helper-plugin-utils": "^7.10.3",
    "@vitest/coverage-v8": "4.1.11",
    "react-alien-signals": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
