{
  "name": "babel-plugin-react-alien-signals",
  "version": "0.0.0",
  "description": "Managed render-scope transform for react-alien-signals.",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && node tests/build-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0",
    "react-alien-signals": "workspace:*"
  },
  "dependencies": {
    "@babel/helper-plugin-utils": "^7.29.7",
    "@babel/types": "^7.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/babel__core": "^7.20.5",
    "@types/babel__helper-plugin-utils": "^7.10.3",
    "react-alien-signals": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  }
}
