{
  "name": "unplugin-react-fine-grained-signals",
  "version": "0.0.0",
  "description": "Universal useSignals transform for react-fine-grained-signals.",
  "license": "MIT",
  "author": "akazawa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakzw/react-fine-grained-signals.git",
    "directory": "packages/unplugin-react-fine-grained-signals"
  },
  "homepage": "https://github.com/sakzw/react-fine-grained-signals/tree/main/packages/unplugin-react-fine-grained-signals#readme",
  "bugs": {
    "url": "https://github.com/sakzw/react-fine-grained-signals/issues"
  },
  "keywords": [
    "unplugin",
    "vite",
    "rollup",
    "webpack",
    "rspack",
    "esbuild",
    "react",
    "signals",
    "fine-grained",
    "react-fine-grained-signals",
    "alien-signals"
  ],
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"if(!/pnpm/i.test(process.env.npm_config_user_agent||process.env.npm_execpath||'')){console.error('Publish this package with pnpm publish, not npm publish -- workspace: peer ranges must be rewritten.');process.exit(1)}\"",
    "build": "tsdown && node tests/build-smoke.mjs",
    "bench": "node --expose-gc benchmarks/transform.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:react-compiler": "vitest run tests/react-compiler.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react-fine-grained-signals": "workspace:^"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/helper-plugin-utils": "^8.0.1",
    "@babel/types": "^8.0.4",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "react-fine-grained-signals": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
